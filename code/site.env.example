# site.env.example - Site-specific configuration
#
# Copy this file and customize for your compute environment.
# Pass to create.sh with --site-config /path/to/site.env

# --- Pipelines to run on this site ---
# Space-separated list of projects
DERIVATIVES="mriqc fmriprep"

# --- Container configuration ---
# Local path to shared ReproNim containers clone (avoids re-downloading)
# CONTAINER_STORE=https://github.com/ReproNim/containers.git
CONTAINER_STORE=/path/to/shared/containers

# --- Storage paths ---
# Scratch directory for working files
SCRATCH_DIR=/tmp

# Base directory for RIA stores (optional, defaults to dataset-local)
# RIA_BASE=/path/to/shared/RIA
